# Copy this file to .env and adjust values for your environment.
# docker compose reads .env automatically.

LISTEN_ADDR=:8080

# URL of the Ollama instance the proxy forwards requests to.
# Use "http://ollama:11434" when Ollama runs inside the same compose stack.
# Use "http://host.docker.internal:11434" for Ollama on the host (Mac/Windows).
# Use "http://172.17.0.1:11434" for Ollama on the host (Linux, docker bridge).
# Use "http://<ip>:11434" for Ollama on a remote machine.
OLLAMA_UPSTREAM=http://ollama:11434

# Persistent data paths inside the container (bind-mounted from ./data/).
DB_PATH=/data/db.sqlite
LOG_PATH=/data/logs/proxy.log

# Log rotation (the proxy rotates LOG_PATH itself; no external logrotate needed).
LOG_MAX_MB=50
LOG_MAX_BACKUPS=5

# Per-session rate limit (requests/minute). 0 = unlimited.
RATE_LIMIT_RPM=0

# Per-session daily ceilings. Rate limiting caps how often a session calls;
# these cap how much it consumes. 0 = unlimited. Cost needs a pricing table.
BUDGET_TOKENS_PER_DAY=0
BUDGET_COST_PER_DAY=0

# Reject request bodies larger than this (MB). 0 disables the cap.
MAX_BODY_MB=32

# Forward at most this many requests at once, queueing the rest; Ollama
# serializes generation anyway. 0 = no queueing. MAX_QUEUE bounds the wait
# queue so an overloaded proxy returns 503 instead of piling up. 0 = unbounded.
MAX_CONCURRENT=0
MAX_QUEUE=0

# Cache identical non-streaming responses for this long (Go duration, e.g. 10m).
# Empty or 0 disables the cache.
CACHE_TTL=
CACHE_MAX_MB=64

# Model-aware routing across multiple upstreams: how often to poll each one's
# /api/tags, and how many consecutive failures take one out of rotation.
UPSTREAM_POLL=30s
CIRCUIT_FAILURES=3
CIRCUIT_COOLDOWN=30s
RETRY_5XX=true

# Record "llama3" as "llama3:latest" so one model is one series, and optionally
# fold further names together. Set NORMALIZE_BACKFILL=true for one start to
# rewrite rows recorded before this was enabled.
NORMALIZE_MODELS=true
MODEL_ALIASES=
NORMALIZE_BACKFILL=false

# Ask OpenAI-compatible streams to report token usage; without it /v1 streaming
# records zero tokens. ESTIMATE_TOKENS guesses from text when nothing is reported.
INJECT_USAGE=true
ESTIMATE_TOKENS=false

# How long in-flight requests may finish after SIGTERM.
SHUTDOWN_GRACE=30s

# Cost estimation: path (inside the container) to a JSON pricing table.
# Leave empty to disable. See pricing.example.json; mount it via docker-compose.
# PRICING_PATH=/data/pricing.json

PROXY_PORT=8080
FRONTEND_PORT=3000
OLLAMA_PORT=11434
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
